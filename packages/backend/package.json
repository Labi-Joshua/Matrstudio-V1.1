{
  "name": "@matr/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9229 --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply matr-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply matr-d1 --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@matr/types": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
