ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8787
VERIFY_SECRET=dev-only-change-me
ADMIN_API_TOKEN=dev-admin-token
R2_ACCOUNT_ID=dev
R2_ACCESS_KEY_ID=dev
R2_SECRET_ACCESS_KEY=dev
CF_ACCOUNT_ID=dev
CF_API_TOKEN=dev
ALERT_WEBHOOK_URL=http://localhost:9999/hook
# Optional locally: RESEND_API_KEY= (verification email), TURNSTILE_SECRET= (captcha)
# Learner auth (see AUTH.md). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev-only-replace-with-32-random-bytes
# Optional locally: GOOGLE_CLIENT_ID= and GOOGLE_CLIENT_SECRET= (Google sign-in turns on when both are set)
# Lower the scrypt cost and the no-enumeration floor for quick local runs (ignored in production):
# PASSWORD_SCRYPT_N=16384
AUTH_MIN_RESPONSE_MS=100
