{
  "name": "@matr/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9229 --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply matr-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply matr-d1 --remote"
  },
  "dependencies": {
    "@better-auth/core": "1.7.18",
    "@better-auth/kysely-adapter": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@hono/zod-validator": "^0.9.1",
    "@matr/types": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.18",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "kysely-d1": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^24.19.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
